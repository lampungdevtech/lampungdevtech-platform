NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=NEXTAUTH_SECRET
GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=GOOGLE_CLIENT_SECRET
GITHUB_ID=GITHUB_ID
GITHUB_SECRET=GITHUB_SECRET
NEXT_PUBLIC_SUPABASE_URL=NEXT_PUBLIC_SUPABASE_UR
NEXT_PUBLIC_SUPABASE_ANON_KEY=NEXT_PUBLIC_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=SUPABASE_SERVICE_ROLE_KEY
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ==============================================================================
# WeselAja (XenithPay Open API) Payment Gateway
# ==============================================================================
# Sandbox URL: https://openapi.sandbox.xenithpay.com
# Production URL: https://openapi.xenithpay.com
WESELAJA_API_URL=https://openapi.sandbox.xenithpay.com
WESELAJA_API_KEY=your-weselaja-xenith-api-key
WESELAJA_SECRET_KEY=your-weselaja-xenith-secret-key
WESELAJA_WEBHOOK_SECRET=your-weselaja-webhook-secret
WESELAJA_CALLBACK_URL=http://localhost:3000/api/payment/weselaja/webhook
WESELAJA_RETURN_URL=http://localhost:3000/id/edutech

# ==============================================================================
# Web Analytics Configuration (Umami or Google Analytics)
# ==============================================================================
# Pilihan provider: 'umami', 'google' (atau 'ga'), 'both', atau kosongkan untuk auto-detect
NEXT_PUBLIC_ANALYTICS_PROVIDER=umami

# Option A: Umami Analytics (Privacy-friendly open-source)
# Default script: https://cloud.umami.is/script.js (atau URL self-hosted Anda)
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-umami-website-id-uuid
# NEXT_PUBLIC_UMAMI_HOST_URL=https://analytics.lampungdevtech.my.id
# NEXT_PUBLIC_UMAMI_DOMAINS=lampungdevtech.my.id,lampungdev.org

# Option B: Google Analytics 4 (GA4)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX