# ==============================================================================
# LAMPUNGDEVTECH PLATFORM ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Web Platform (Next.js 15)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NextAuth v4 (Authentication)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=lampungdevtech-secret-key-change-in-production

# Google OAuth Provider (Member & Mitra POS Login)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# 2. Event Management (MongoDB)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://root:example@localhost:27017/lampungdev_events?authSource=admin

# ------------------------------------------------------------------------------
# 3. POS Backend Microservice (Golang GoFiber Hexagonal)
# ------------------------------------------------------------------------------
GO_ENV=development
GO_PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pos_db?sslmode=disable
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=pos.events
JWT_SECRET=lampungdevtech-super-secret-pos-jwt-key-2026

# ------------------------------------------------------------------------------
# 4. Mobile POS & Tablet (React Native Expo)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1/pos
