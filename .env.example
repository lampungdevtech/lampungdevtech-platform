# ==============================================================================
# LAMPUNGDEVTECH PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' or 'apps/web/.env.local' and adjust the values accordingly.
# Do NOT commit sensitive production credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Web Platform (Next.js 15 App Router)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NextAuth.js v4 Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=lampungdevtech-secret-key-change-in-production

# Google OAuth 2.0 Credentials (for Member Login and Business Partner Onboarding)
# Create credentials in Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# 2. Event Management Service (MongoDB)
# ------------------------------------------------------------------------------
# Connection string for the MongoDB instance used for event catalog, ticket capacity,
# atomic registrations, waiting list queues, and QR check-in records.
MONGODB_URI=mongodb://root:example@localhost:27017/lampungdev_events?authSource=admin

# ------------------------------------------------------------------------------
# 3. POS Backend Microservice (Golang GoFiber Hexagonal Architecture)
# ------------------------------------------------------------------------------
GO_ENV=development
GO_PORT=8080

# PostgreSQL (ACID Relational Ledger for Orders, Shifts, Cash Floats, and Multi-Branch)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pos_db?sslmode=disable

# Redis (Distributed Table Locking & Performance Caching)
REDIS_URL=redis://localhost:6379

# RabbitMQ AMQP Broker (Event Bus for Asynchronous Outbox Notifications)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=pos.events

# JWT Secret for Cashier Staff Shift Authentication (24-Hour Shift Sessions)
JWT_SECRET=lampungdevtech-super-secret-pos-jwt-key-2026

# ------------------------------------------------------------------------------
# 4. Mobile POS & Tablet Client (React Native Expo Offline-First)
# ------------------------------------------------------------------------------
# Endpoint used by the offline sync engine when network connection is restored
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1/pos

# ------------------------------------------------------------------------------
# 5. WeselAja (XenithPay Open API) Payment Gateway
# ------------------------------------------------------------------------------
# Multi-channel payment gateway supporting QRIS, BCA/Mandiri/BNI/BRI VA, and E-Wallets
WESELAJA_API_URL=https://openapi.sandbox.xenithpay.com
WESELAJA_API_KEY=your-weselaja-xenith-api-key
WESELAJA_SECRET_KEY=your-weselaja-xenith-secret-key
WESELAJA_WEBHOOK_SECRET=your-weselaja-webhook-secret
WESELAJA_CALLBACK_URL=http://localhost:3000/api/payment/weselaja/webhook
WESELAJA_RETURN_URL=http://localhost:3000/id/edutech

